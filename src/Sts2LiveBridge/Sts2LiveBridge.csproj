<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Version>0.1.7</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\Slay the Spire 2</Sts2GameDir>
    <GameAssemblies>$([System.IO.Path]::Combine('$(Sts2GameDir)', 'data_sts2_windows_x86_64'))</GameAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(GameAssemblies)/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(GameAssemblies)/GodotSharp.dll" Private="false" />
    <None Update="Sts2LiveBridge.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckSteamInstallation" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameAssemblies)/sts2.dll') Or !Exists('$(GameAssemblies)/GodotSharp.dll')"
           Text="Set -p:Sts2GameDir to a Steam Slay the Spire 2 installation path." />
  </Target>
</Project>
